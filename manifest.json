{
  "manifest_version": 3,
  "name": "R6 Pixel Siege",
  "version": "0.18.0",
  "description": "2D pixel-art tactical breach and clear shooter. Play in the popup, or open it fullscreen in a tab.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "R6 Pixel Siege",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}